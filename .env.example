BOT_TOKEN=your_bot_token_here
ADMIN_IDS=[749256529]
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
LOG_LEVEL=INFO

# Legacy proxy for disabled Avito diagnostics only.
# Формат: http://user:pass@host:port  или  socks5://user:pass@host:port
# Auto.ru never reads this value.
PROXY_URL=http://username:password@proxy-host:port
# Dedicated proxy used only by Auto.ru.
AUTORU_PROXY_URL=
# PROXY_URL is ignored by Auto.ru.
AUTORU_TIMEOUT_SECONDS=15

# Rest-App Avito shared collection/cache settings.
REST_APP_MAX_TIME_WINDOWS=6
REST_APP_CACHE_TTL=300
REST_APP_RESULT_LIMIT=50
REST_APP_DB_MAX_AGE_HOURS=24
REST_APP_DEMO_RELAX_PRICE=true

# Авито только через Rest-App API. Proxy/VLESS для Авито не используются.
# disabled | rest_app | adspower_worker
AVITO_PROVIDER=disabled
REST_APP_LOGIN=
REST_APP_TOKEN=
REST_APP_TIMEOUT=30
REST_APP_TEST_REGION=Новосибирская область
REST_APP_TEST_CITY=Новосибирск
AVITO_MIN_INTERVAL_SECONDS=120
AVITO_BLOCK_COOLDOWN_SECONDS=7200
AVITO_MAX_INTERNAL_REDIRECTS=1
AVITO_CACHE_TTL_SECONDS=1800
AVITO_STALE_CACHE_TTL_SECONDS=86400
AVITO_MANUAL_WAIT_SECONDS=20

# AdsPower parser-worker. Configure these only on the machine running AdsPower.
ADSPOWER_API_URL=http://127.0.0.1:50325
ADSPOWER_PROFILE_ID=
ADSPOWER_API_KEY=
AVITO_REQUIRE_AUTH=true
AVITO_STOP_PROFILE_ON_EXIT=false
AVITO_MAX_PAGES=2
AVITO_MAX_ITEMS=50
AVITO_DETAIL_MODE=full
AVITO_DETAIL_CONCURRENCY=1
AVITO_PROFILE_START_TIMEOUT=30
AVITO_CDP_CONNECT_TIMEOUT=15
AVITO_NAVIGATION_TIMEOUT=25
AVITO_LOCATOR_TIMEOUT=15
AVITO_LISTING_TIMEOUT=20
AVITO_SEARCH_DEADLINE=180
AVITO_RETRY_ATTEMPTS=2
AVITO_DELAY_MIN_SECONDS=1.2
AVITO_DELAY_MAX_SECONDS=3.5
AVITO_WORKER_HOST=127.0.0.1
AVITO_WORKER_PORT=8081
AVITO_WORKER_TOKEN=

# Railway client settings. Enable only after a successful local diagnostic.
AVITO_WORKER_URL=
AVITO_WORKER_TIMEOUT_SECONDS=190

# Отдельный обязательный proxy только для Авито. Credentials не коммитить.
AVITO_PROXY_HOST=mproxy.site
AVITO_PROXY_PORT=17412
AVITO_PROXY_PROTOCOL=http
AVITO_PROXY_USER=
AVITO_PROXY_PASS=
AVITO_PROXY_TIMEOUT=30
AVITO_PROXY_COOLDOWN_SECONDS=3600

# Ссылка ротации задаётся только на production и вызывается вручную.
AVITO_PROXY_ROTATE_URL=

DASHBOARD_KEY=change_me_secret
PORT=8080

# ЮMoney: номер кошелька и секрет из Настройки -> HTTP-уведомления.
# URL уведомлений в ЮMoney: https://ВАШ-ДОМЕН/yoomoney/webhook
YOOMONEY_WALLET=
YOOMONEY_NOTIFICATION_SECRET=
PUBLIC_URL=

# Xray/VLESS proxy (credentials via env, NOT in repo):
XRAY_UUID=
XRAY_ADDRESS=ru.axolab.org
XRAY_PORT=443
XRAY_PUBLIC_KEY=
XRAY_SNI=sun9-8.userapi.com
XRAY_SHORT_ID=
XRAY_AUTOSTART=0

# Отключение проверки TLS-сертификатов (только для отладки SOCKS-прокси): DISABLE_SSL_VERIFY=1
DISABLE_SSL_VERIFY=0
