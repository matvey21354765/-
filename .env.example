# Альтернативная поштучная настройка прокси (если не задан PROXY_URL):
# AVITO_PROXY_HOST=
# AVITO_PROXY_PORT=
# AVITO_PROXY_USER=
# AVITO_PROXY_PASS=
# AVITO_PROXY_PROTOCOL=http

# Ссылка для ротации IP мобильного прокси (mobileproxy.space / ltespace).
