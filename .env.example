BOT_TOKEN=your_bot_token_here
ADMIN_IDS=[749256529]
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
LOG_LEVEL=INFO

# Shared proxy URL. Auto.ru does not read this value.
# Формат: http://user:pass@host:port или socks5://user:pass@host:port
PROXY_URL=http://username:password@proxy-host:port

# Dedicated proxy used only by Auto.ru.
AUTORU_PROXY_URL=
AUTORU_TIMEOUT_SECONDS=15

# Avito browser provider. REST-App has been removed.
AVITO_ENABLED=true
AVITO_PROVIDER=playwright
AVITO_SOURCE=playwright
AVITO_HEADLESS=true
AVITO_BROWSER_TIMEOUT_SECONDS=30
AVITO_NAVIGATION_TIMEOUT_SECONDS=30
AVITO_MAX_CONCURRENT_PAGES=1
AVITO_BROWSER_RESTART_AFTER_SEARCHES=50
AVITO_HISTORY_ENABLED=true

# Avito proxy: residential/mobile pool used by Playwright.
AVITO_PROXY_HOST=pool.proxys.io
AVITO_PROXY_PORT_START=10000
AVITO_PROXY_PORT_END=10999
AVITO_PROXY_USERNAME=
AVITO_PROXY_PASSWORD=
AVITO_PROXY_PROTOCOL=http
AVITO_PROXY_CHECK_LIMIT=10
AVITO_PROXY_CONNECT_TIMEOUT_SECONDS=8
AVITO_PROXY_STICKY_MINUTES=60

# Or configure one dedicated proxy URL instead of the pool.
AVITO_PROXY_URL=

AVITO_MIN_INTERVAL_SECONDS=120
AVITO_BLOCK_COOLDOWN_SECONDS=7200
AVITO_MAX_INTERNAL_REDIRECTS=1
AVITO_CACHE_TTL_SECONDS=1800
AVITO_STALE_CACHE_TTL_SECONDS=86400
AVITO_MANUAL_WAIT_SECONDS=20
AVITO_MAX_PAGES=2
AVITO_MAX_ITEMS=50

# Optional AdsPower worker. Configure only when deliberately selected with
# AVITO_PROVIDER=adspower_worker.
ADSPOWER_API_URL=http://127.0.0.1:50325
ADSPOWER_PROFILE_ID=
ADSPOWER_API_KEY=
AVITO_REQUIRE_AUTH=true
AVITO_STOP_PROFILE_ON_EXIT=false
AVITO_DETAIL_MODE=full
AVITO_DETAIL_CONCURRENCY=1
AVITO_PROFILE_START_TIMEOUT=30
AVITO_CDP_CONNECT_TIMEOUT=15
AVITO_LOCATOR_TIMEOUT=15
AVITO_LISTING_TIMEOUT=20
AVITO_SEARCH_DEADLINE=180
AVITO_RETRY_ATTEMPTS=2
AVITO_DELAY_MIN_SECONDS=1.2
AVITO_DELAY_MAX_SECONDS=3.5
AVITO_WORKER_HOST=127.0.0.1
AVITO_WORKER_PORT=8081
AVITO_WORKER_TOKEN=
AVITO_WORKER_URL=
AVITO_WORKER_TIMEOUT_SECONDS=190

DASHBOARD_KEY=change_me_secret
PORT=8080

# ЮMoney: номер кошелька и секрет из Настройки -> HTTP-уведомления.
YOOMONEY_WALLET=
YOOMONEY_NOTIFICATION_SECRET=
PUBLIC_URL=

# Xray/VLESS proxy (credentials via env, NOT in repo).
XRAY_UUID=
XRAY_ADDRESS=ru.axolab.org
XRAY_PORT=443
XRAY_PUBLIC_KEY=
XRAY_SNI=sun9-8.userapi.com
XRAY_SHORT_ID=
XRAY_AUTOSTART=0

# Отключение проверки TLS-сертификатов (только для отладки SOCKS-прокси).
DISABLE_SSL_VERIFY=0
