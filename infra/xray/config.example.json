{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "avito-socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "vless-reality",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "REPLACE_ON_VPS",
            "port": 443,
            "users": [
              {
                "id": "REPLACE_ON_VPS",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "REPLACE_ON_VPS",
          "publicKey": "REPLACE_ON_VPS",
          "shortId": "REPLACE_ON_VPS",
          "fingerprint": "chrome"
        }
      }
    }
  ]
}
